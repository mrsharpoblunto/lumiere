// The Worker that serves the browser build of Lumiere at pixelheart.io.
// It only has static assets, so requests are free and do not run Worker code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixelheart-io",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist/www"
  },
  "dev": {
    "port": 4002
  },
  "routes": [{ "pattern": "pixelheart.io", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
